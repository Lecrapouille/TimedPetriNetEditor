  "type": "Timed Petri net",
  "nets": [
    {
       "name": "Timeout",
       "description": "A timeout is a transition with a delay, in conflict with the answer. The reply comes 5 time units after Send, but Timeout fires once Waiting has been marked for 3 (its delay): the request goes to Error. Set the duration of Send -> Reply to 2: Receive wins.",
       "places": [
            { "id": 0, "caption": "Request", "tokens": 1 },
