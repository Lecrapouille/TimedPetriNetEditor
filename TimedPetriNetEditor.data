{
  "revision": 2,
  "type": "GRAFCET",
  "description": "Bottling line driven by a GEMMA (its GEMMA windows open with the file). Before the production the tank is filled (F2); then each bottle under the nozzle is filled, capped and taken out (F1). Stop finishes the bottle and empties the tank (A2, F3); Pause stops after the bottle (A3, A4). A jam of the capper stops the line (D2): Ack after clearing it, or Degraded to go on without capping (D3). The emergency stop forces everything (D1) until Rearm, Ack and no bottle under the nozzle (A5, A6). Manual: the conveyor and the filling by hand (F4). To start: Start, wait for the tank, put a Bottle.",
  "nets": [
    {
       "name": "Safety",
       "description": "Safety: while the emergency stop is pushed, then until the rearm (Rearm), Control is forced to D1 and Production to its initial situation.",
       "places": [
            { "id": 0, "caption": "Watch", "tokens": 1 },
            { "id": 1, "caption": "Emergency stop", "tokens": 0 }
       ],
       "transitions": [
            { "id": 0, "caption": "EStop" },
            { "id": 1, "caption": "/EStop . Rearm" }
       ],
       "arcs": [
            { "from": "P0", "to": "T0" },
            { "from": "T0", "to": "P1", "duration": 0 },
            { "from": "P1", "to": "T1" },
            { "from": "T1", "to": "P0", "duration": 0 }
       ],
       "actions": [
